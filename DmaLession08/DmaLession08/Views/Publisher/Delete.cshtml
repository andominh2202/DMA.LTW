@model DmaLession08.Models.Publisher
@{
    ViewData["Title"] = "Xóa Nhà Xuất Bản";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Xác nhận xóa Nhà Xuất Bản?</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Mã NXB:</dt>
                    <dd class="col-sm-8"><strong>@Model.PublisherId</strong></dd>

                    <dt class="col-sm-4 text-muted">Tên NXB:</dt>
                    <dd class="col-sm-8">@Model.PublisherName</dd>

                    <dt class="col-sm-4 text-muted">Số đầu sách:</dt>
                    <dd class="col-sm-8">@Model.Books.Count đầu sách</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
                <form asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" asp-for="PublisherId" />
                    <button type="submit" class="btn btn-danger">Xóa NXB</button>
                </form>
                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
            </div>
        </div>
    </div>
</div>
