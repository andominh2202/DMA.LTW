@model IEnumerable<DoMinhAn_241230648.Models.Sach>

@{
    Layout = "~/Views/Shared/DoMinhAn_Layout.cshtml";
}

@await Html.PartialAsync("DoMinhAn_MainContent", Model)

@section Scripts{
    <script>
        document.addEventListener("click", async function (e) {
            if (!(e.target instanceof Element)) return;
            const link = e.target.closest(".category-link");
            if (!link) return;
            e.preventDefault();

            const id = link.getAttribute("data-id");
            const name = link.getAttribute("data-name");
            const bookList = document.getElementById("book-list");
            const bookTitle = document.getElementById("book-title");
            if (!id || !bookList || !bookTitle) return;

            try {
                const url = '@Url.Action("LocSach", "Home")'
                    + "?id=" + encodeURIComponent(id);
                const response = await fetch(url);

                if (!response.ok) {
                    throw new Error("HTTP" + response.status);
                }
                const html = await response.text();

                bookList.innerHTML = html;
                bookTitle.textContent = name;
            }
            catch (error) {
                const message = error instanceof Error ? error.message : String(error);
                alert("Lỗi đọc sách: " + message);
                console.error(error);
            }
        });
    </script>
}
