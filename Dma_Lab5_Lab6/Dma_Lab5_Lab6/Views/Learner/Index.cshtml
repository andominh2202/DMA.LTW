@model IEnumerable<Learner>
@{
    ViewData["Title"] = "Danh sách người học";
    Layout = "~/Views/Shared/MyLayout.cshtml";
    bool useAjax = ViewBag.UseAjax ?? true;
}

<div class="ms-2 mx-2">
    <h1>Danh sách người học</h1>
    @await Component.InvokeAsync("Major")
    <form id="learner-search" asp-controller="Learner" asp-action="Index" method="get" class="mb-3">
        <input type="hidden" id="selected-major" name="mid" value="@ViewBag.mid" />
        <div class="input-group mb-2" style="max-width: 360px">
            <input id="keyword" name="keyword" value="@ViewBag.keyword" class="form-control"
                   placeholder="Tìm tên người học" aria-label="Tìm theo tên người học" />
            <button id="btnSearch" type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
        <div class="form-check">
            <input id="use-ajax" name="ajax" type="checkbox" value="true" checked="@useAjax" class="form-check-input" />
            <label for="use-ajax" class="form-check-label">Tải dữ liệu bằng AJAX (bỏ chọn để tải lại trang)</label>
            <input type="hidden" name="ajax" value="false" />
        </div>
    </form>
    <div id="filter-error" class="alert alert-danger d-none" role="alert">Không tải được dữ liệu. Vui lòng thử lại.</div>
    <div id="content" aria-live="polite" data-filter-url="@Url.Action("LearnerFilter", "Learner")">
        <partial name="LearnerTable" model="Model" />
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm người học</a>
</div>

@section Scripts {
    <script src="~/js/learner.js" asp-append-version="true"></script>
}
