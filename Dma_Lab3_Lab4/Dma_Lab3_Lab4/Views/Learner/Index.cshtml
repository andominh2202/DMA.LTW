@model IEnumerable<Dma_Lab3_Lab4.Models.Learner>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}

<div class="ms-2 mx-2">
    <h1>Learner List</h1>
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th>Họ</th>
                <th>Ngành</th>
                <th>Ngày Nhập Học</th>
                <th>Chức năng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.LearnerID</td>
                    <td>@s.FirstMidName</td>
                    <td>@s.LastName</td>
                    <td>@(s.Major != null ? s.Major.MajorName : "")</td>
                    <td>@s.EnrollmentDate.ToString("g")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@s.LearnerID">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@s.LearnerID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Create" class="btn btn-primary">Create New Learner</a>
</div>