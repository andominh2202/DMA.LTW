@model Student
@{
    Layout = "~/Views/Shared/MyLayoutHelper.cshtml";
    ViewData["Title"] = "Create Student";
}

<div>
    <div asp-validation-summary="All" class="text-danger"></div>
    <form asp-controller="Student" asp-action="Create" method="post" class="mt-3">
        <div class="form-group row mt-2">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
            </div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Password" class="col-sm-2 col-form-label">Mật khẩu</label>
            <div class="col-sm-10">
                <input type="password" asp-for="Password" class="form-control" placeholder="Password" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành</label>
            <div class="col-sm-10">
                <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<Branch>()"></select>
            </div>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Hệ đào tạo</label>
            <div class="col-sm-10">
                <input type="checkbox" asp-for="IsRegular" /> Chính quy
            </div>
            <span asp-validation-for="IsRegular" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="DateOfBirth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input type="date" asp-for="DateOfBirth" class="form-control" />
            </div>
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Gender" class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                @if (ViewBag.AllGenders != null)
                {
                    @foreach (var gender in ViewBag.AllGenders)
                    {
                        <label class="radio-inline me-3">
                            <input type="radio" asp-for="Gender" value="@gender" id="Gender@(gender)" /> @gender
                        </label>
                    }
                }
            </div>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
            </div>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        <div class="form-group row mt-2">
            <label asp-for="Mark" class="col-sm-2 col-form-label">Điểm</label>
            <div class="col-sm-10">
                <input asp-for="Mark" class="form-control" placeholder="Điểm (0 - 10)" />
            </div>
            <span asp-validation-for="Mark" class="text-danger"></span>
        </div>

        <div class="form-group row mt-3">
            <div class="col-sm-10">
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}