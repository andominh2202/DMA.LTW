@model IEnumerable<DoMinhAn_241230648_de2023.Models.HangHoa>

<div class="selection group">
    @foreach (var item in Model)
    {
        <div class="grid_1_of_4 images_1_of_4">
            <img src="@Url.Content("~/images/" + item.Anh)" alt="@item.TenHang"/>
            <h2>@item.TenHang</h2>
            <div class="price-details">
                <div class="price-number">
                    <p>
                        <span class="rupees">
                            @item.Gia
                        </span>
                    </p>
                </div>
                <div class="clear"></div>
            </div>
        </div>
    }
</div>