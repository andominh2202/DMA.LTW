@model IEnumerable<DmaLession04.Models.Book>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="@item.Image" class="card-img-top" alt="@item.Title" style="height: 250px; object-fit: cover;">
                }
                else
                {
                    <img src="https://placehold.co/400x250?text=No+Image" class="card-img-top" alt="No image">
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text text-muted">@item.Summary</p>
                    <div class="mt-auto">
                        <span class="text-danger fw-bold">@item.Price.ToString("N0") VNĐ</span>
                        <a href="/Book/Edit/@item.Id" class="btn btn-sm btn-outline-primary float-end">Chi tiết</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
