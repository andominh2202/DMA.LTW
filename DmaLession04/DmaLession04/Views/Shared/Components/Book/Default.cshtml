@model IEnumerable<DmaLession04.Models.Book>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-xs-3 col-sm-3 col-md-3 col-lg-3">
            <div class="thumbnail">
                <img src="@item.Image" alt="" style="width:100%">
                <div class="caption">
                    <h3>@item.Title</h3>
                    <p>Price: @item.Price</p>
                </div>
            </div>
        </div>
    }
</div>
