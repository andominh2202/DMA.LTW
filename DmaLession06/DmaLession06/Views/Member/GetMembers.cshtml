@{
}
<h2>Danh sách thành viên</h2>
<a href="Create" class="btn btn-primary">Thêm thành viên</a>
<table>
    <tr>
        <th>Mã thành viên</th>
        <th>Username</th>
        <th>Họ tên</th>
        <th>Password</th>
        <th>Email</th>
    </tr>
    @foreach (var member in ViewBag.members)
    {
        <tr>
            <td>@member.MemberId</td>
            <td>@member.UserName</td>
            <td>@member.FullName</td>
            <td>@member.Password</td>
            <td>@member.Email</td>
        </tr>
    }
</table>